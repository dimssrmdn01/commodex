  create view "komoditas_db"."public"."stg_harga_pasar__dbt_tmp"
    
    
  as (
    with raw_data as (
    select * from "komoditas_db"."public"."bronze_harga_pasar"
),

deduped as (
    select
        *,
        row_number() over (
            partition by asset_id, last_updated_timestamp
            order by ingested_at desc
        ) as rn
    from raw_data
)

select
    asset_id,
    price_idr::numeric as price_idr,
    price_usd::numeric as price_usd,
    round(change_24h_idr::numeric, 2) as change_24h_pct,
    to_timestamp(last_updated_timestamp) as last_updated_at,
    ingested_at::timestamp as ingested_at
from deduped
where rn = 1
  );
