  create view "komoditas_db"."public"."stg_harga_pasar__dbt_tmp"
    
    
  as (
    with raw_data as (
    select * from "komoditas_db"."public"."bronze_harga_pasar"
),

deduped as (
    select
        *,
        row_number() over (
            partition by asset_id, last_updated_timestamp
            order by ingested_at desc
        ) as rn
    from raw_data
)

